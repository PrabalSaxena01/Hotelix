datasource db {
  provider = "postgresql"
  url      = env("HOTELIX_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id // Clerk user ID (e.g. user_2unqy...)
  email                String    @unique
  username             String
  image                String?
  role                 String    @default("user") // "user" | "hotelOwner"
  recentSearchedCities String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hotels   Hotel[]
  bookings Booking[]

  @@map("users")
}

model Hotel {
  id        String    @id @default(uuid())
  name      String
  address   String
  contact   String
  city      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rooms      Room[]
  bookings   Booking[]
  policies   Policy[]
  addons     AddOn[]
  promotions Promotion[]
  amenities  Amenity[]

  @@map("hotels")
}

model Room {
  id            String    @id @default(uuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType      String    // "Single Bed", "Double Bed", etc.
  pricePerNight Float
  amenities     String[]  // PostgreSQL native TEXT[]
  images        String[]  // Cloudinary image URLs
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]

  @@map("rooms")
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checkInDate   DateTime
  checkOutDate  DateTime
  totalPrice    Float
  guests        Int      @default(1)
  status        String   @default("pending") // "pending" | "confirmed" | "cancelled"
  paymentMethod String   @default("Pay at hotel")
  isPaid        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bookings")
}

// ==========================================
// EXPANDED MODULAR MODELS (Policies, Utilities, Add-Ons, Promotions, FAQs, Inquiries)
// ==========================================

model PolicyCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?  @default("ShieldCheck")
  order       Int      @default(0)
  policies    Policy[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("policy_categories")
}

model Policy {
  id          String         @id @default(uuid())
  categoryId  String
  category    PolicyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  content     String         @db.Text
  importance  String         @default("standard") // "mandatory" | "standard" | "optional"
  hotelId     String?
  hotel       Hotel?         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("policies")
}

model AddOn {
  id          String   @id @default(uuid())
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Float
  priceType   String   @default("per_stay") // "per_stay" | "per_night" | "per_guest"
  category    String   @default("wellness") // "transport" | "dining" | "wellness" | "entertainment"
  image       String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addons")
}

model Promotion {
  id            String    @id @default(uuid())
  hotelId       String?
  hotel         Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code          String    @unique
  title         String
  description   String?   @db.Text
  discountType  String    @default("percentage") // "percentage" | "fixed"
  discountValue Float
  validFrom     DateTime  @default(now())
  validTo       DateTime
  minNights     Int       @default(1)
  bannerImage   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("promotions")
}

model AmenityCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  icon      String?   @default("Sparkles")
  amenities Amenity[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("amenity_categories")
}

model Amenity {
  id          String          @id @default(uuid())
  categoryId  String
  category    AmenityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?         @db.Text
  icon        String?         @default("CheckCircle")
  isFeatured  Boolean         @default(false)
  hotelId     String?
  hotel       Hotel?          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("amenities")
}

model Faq {
  id        String   @id @default(uuid())
  category  String   @default("General") // "General" | "Booking" | "Policies" | "Facilities"
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("pending") // "pending" | "in_progress" | "resolved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inquiries")
}
